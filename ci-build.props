<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Disable PostBuild events for CI builds -->
    <RunPostBuildEvent>Never</RunPostBuildEvent>
    
    <!-- Set default paths for CI if not provided -->
    <PLUGIN_SDK_DIR Condition="'$(PLUGIN_SDK_DIR)' == ''">$(MSBuildProjectDirectory)\..\plugin-sdk</PLUGIN_SDK_DIR>
    <DXSDK_DIR Condition="'$(DXSDK_DIR)' == ''">$(MSBuildProjectDirectory)\..\dxsdk</DXSDK_DIR>
    
    <!-- Set dummy GTA directory paths to prevent PostBuildEvent failures -->
    <GTA_SA_DIR Condition="'$(GTA_SA_DIR)' == ''">$(MSBuildProjectDirectory)\..\dummy-gta-sa</GTA_SA_DIR>
    <GTA_VC_DIR Condition="'$(GTA_VC_DIR)' == ''">$(MSBuildProjectDirectory)\..\dummy-gta-vc</GTA_VC_DIR>
    <GTA_III_DIR Condition="'$(GTA_III_DIR)' == ''">$(MSBuildProjectDirectory)\..\dummy-gta-iii</GTA_III_DIR>
  </PropertyGroup>
</Project>